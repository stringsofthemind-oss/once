{
  "schema_version": "once-agent-routing-conformance-v1",
  "contract_schema_version": "once-agent-discovery-v1",
  "scope": "current execution-safety product only",
  "scope_note": "Freshness / has_changed routing is intentionally out of scope for this suite because it is not part of the currently shipped Once execution-safety product.",
  "decision_rule": "EVALUATE_ONCE only when all four routing conditions are true.",
  "routes": [
    "BYPASS_ONCE",
    "EVALUATE_ONCE"
  ],
  "actions": [
    "DIRECT",
    "PROTECT",
    "EXECUTE",
    "REPLAY_OR_SUPPRESS",
    "BLOCK_AND_RECONCILE"
  ],
  "cases": [
    {
      "id": "read_public_docs",
      "description": "Read public product documentation with HTTP GET.",
      "conditions": {
        "changes_external_state": false,
        "same_logical_operation_may_retry": true,
        "first_attempt_can_be_ambiguous": true,
        "blind_duplicate_undesirable_or_costly": false
      },
      "expected": {
        "route": "BYPASS_ONCE",
        "action": "DIRECT"
      }
    },
    {
