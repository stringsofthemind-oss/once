{
  "name": "@once-agent/mcp",
  "version": "0.1.3",
  "mcpName": "io.github.stringsofthemind-oss/once",
  "description": "MCP idempotency and AI agent retry safety for consequential writes and ambiguous timeouts.",
  "type": "module",
  "bin": {
    "once-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agent-idempotency",
    "mcp-idempotency",
    "retry-safety",
    "safe-retries",
    "execution-safety",
    "duplicate-execution",
    "duplicate-side-effects",
    "ambiguous-timeout",
    "unknown-outcome",
    "idempotency",
    "idempotency-keys",
    "durable-replay",
    "provider-reconciliation",
    "refund-safety",
    "booking-safety",
    "tool-calling",
    "side-effects"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@once-agent/sdk": "0.1.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.6.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stringsofthemind-oss/once.git",
    "directory": "mcp"
  },
  "homepage": "https://onceexec.com/",
  "bugs": {
    "url": "https://github.com/stringsofthemind-oss/once/issues"
  }
}
