{
  "name": "once-evaluation-live-e2e",
  "main": "e2e/bridge.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-23",
  "secrets": {
    "required": ["E2E_TOKEN"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Q18_TRUTH",
        "class_name": "Q18Truth",
        "script_name": "once-q18-cloud"
      },
      {
        "name": "SANDBOX_CLAIMS",
        "class_name": "SandboxClaim",
        "script_name": "once-sandbox-playground"
      }
    ]
  }
}
