{
  "name": "once-q18-cloud",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-09-16",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Q18_TRUTH",
        "class_name": "Q18Truth"
      }
    ]
  },
  "exports": {
    "Q18Truth": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
