{
  "name": "once-sandbox-playground",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-09-18",
  "analytics_engine_datasets": [
    {
      "binding": "ONCE_ANALYTICS",
      "dataset": "once_product_events"
    }
  ],
  "vars": {
    "ONCE_CORE_URL": "https://api.onceexec.com",
    "STRIPE_PRICE_PRO": "price_1UGqPRAHX5spO4zqQcuRzi3S",
    "STRIPE_PRICE_SCALE": "price_1UGqPfAHX5spO4zqKaLaAINp",
    "STRIPE_PRICE_STARTUP": "price_1UGqPWAHX5spO4zqWlFeMbwO"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Q18_TRUTH",
        "class_name": "Q18Truth",
        "script_name": "once-q18-cloud"
      },
      {
        "name": "SANDBOX_CLAIMS",
        "class_name": "SandboxClaim"
      },
      {
        "name": "SANDBOX_DEMO",
        "class_name": "SandboxDemoEffect"
      }
    ]
  }
}