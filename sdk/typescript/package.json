{
  "name": "@once-agent/sdk",
  "version": "0.1.11",
  "description": "Execution safety for side-effecting AI agent tools.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./connect": {
      "types": "./dist/connect/index.d.ts",
      "import": "./dist/connect/index.js",
      "require": "./dist-cjs/connect/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js",
      "require": "./dist-cjs/discovery/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "dist-cjs"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "typecheck": "tsc --noEmit",
    "benchmark:scan": "npm run build && node ./scripts/scan-benchmark.mjs",
    "test:benchmark": "npm run build && node ./scripts/benchmark-regression.mjs",
    "test:trace": "npm run build && node ./scripts/trace-regression.mjs",
    "test:dataset-seal": "npm run build && node ./scripts/dataset-seal-regression.mjs",
    "test:dataset-progress": "npm run build && node ./scripts/dataset-progress-regression.mjs",
    "test:agent-discovery": "node ./scripts/agent-discovery-regression.mjs",
    "test:doctor": "npm run build && node ./scripts/doctor-adoption-regression.mjs",
    "test:tool-discovery": "npm run build && node ./scripts/tool-discovery-regression.mjs && node ./scripts/mcp-live-discovery-regression.mjs && node ./scripts/mcp-tool-refresh-regression.mjs && node ./scripts/runtime-tool-discovery-regression.mjs && node ./scripts/vercel-runtime-tool-discovery-regression.mjs",
    "routing:check": "node ./scripts/agent-routing-conformance.mjs",
    "routing:cases": "node ./scripts/agent-routing-conformance.mjs --emit-cases",
    "test:routing-conformance": "node ./scripts/agent-routing-conformance-regression.mjs",
    "test:contract": "npm run build && tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --types node ./scripts/sdk-contract-types.ts && node ./scripts/sdk-contract-runtime.mjs",
    "test:release": "npm run benchmark:scan && npm run test:benchmark && npm run test:trace && npm run test:dataset-seal && npm run test:dataset-progress && npm run test:agent-discovery && npm run test:doctor && npm run test:tool-discovery && npm run test:routing-conformance && npm run test:scanner-declarations && npm run test:contract && npm run test:protect && npm run test:capabilities && npm run test:transformer && npm run test:binding && npm run test:patch-planner && npm run test:transformer-protect && npm run test:apply && npm run test:id-conformance && npm run test:consumer && npm run test:connect-package && npm run test:discovery-package && npm run test:activation && npm run test:package && npm run test:runtime-setup && npm run test:connect",
    "test:local": "npm run build && node --test ./test/local.test.mjs ./test/connect/local-agent-tool.test.mjs",
    "test:connect": "npm run build && node --test ./test/connect/*.test.mjs",
    "test:connect-package": "node ./scripts/connect-package-regression.mjs",
    "test:discovery-package": "node ./scripts/runtime-discovery-package-regression.mjs",
    "test:connect-package-protected": "node ./scripts/connect-packed-protection-regression.mjs",
    "test:protect": "npm run build && node ./scripts/protect-regression.mjs",
    "test:capabilities": "npm run build && node ./scripts/capability-regression.mjs",
    "test:transformer": "npm run build && node ./scripts/http-transformer-regression.mjs",
    "test:scanner-declarations": "npm run build && node ./scripts/scanner-declaration-regression.mjs",
    "test:transformer-protect": "npm run build && node ./scripts/transformer-protect-regression.mjs",
    "test:binding": "npm run build && node ./scripts/once-binding-regression.mjs",
    "test:patch-planner": "npm run build && node ./scripts/http-patch-planner-regression.mjs",
    "test:apply": "npm run build && node ./scripts/apply-engine-regression.mjs && node ./scripts/apply-regression.mjs",
    "test:package": "npm run build && node ./scripts/package-isolation-regression.mjs",
    "test:consumer": "npm run build && node ./scripts/consumer-package-regression.mjs",
    "test:id-conformance": "npm run build && node ./scripts/id-conformance-regression.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node ./scripts/write-cjs-package.mjs",
    "test:runtime-setup": "npm run build && node ./scripts/runtime-setup-regression.mjs",
    "test:activation": "npm run build && node ./scripts/activation-regression.mjs",
    "test:setup-persistence": "npm run build && node ./scripts/setup-persistence-regression.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "idempotency",
    "reliability",
    "execution-safety",
    "safe-retries",
    "retry-safety",
    "agent-safety",
    "distributed-systems",
    "ambiguous-timeout",
    "duplicate-side-effects",
    "provider-reconciliation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.1"
  },
  "bin": {
    "once": "dist/cli.js",
    "once-dataset": "dist/dataset-cli.js"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stringsofthemind-oss/once.git"
  },
  "homepage": "https://onceexec.com/",
  "bugs": {
    "url": "https://github.com/stringsofthemind-oss/once/issues"
  }
}
